# Copy to .env (setup.bat does this for you) and fill in the blanks.
# .env is gitignored — never commit real secrets.

# SQLite database file, relative to the project root.
DATABASE_URL="file:./dev.db"

# Signs the session cookie. Must be a long random string; the server refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
